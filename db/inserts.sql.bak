INSERT INTO review (user_id, disk_id, edition_name, content) VALUES
(1, 20, 'Standard Edition', 'Hybrid Theory is a masterpiece that defined a generation. The raw emotion and energy in every track is incredible.'),
(2, 14, 'Standard Edition', 'After Hours showcases The Weeknds evolution as an artist. Dark, atmospheric, and absolutely brilliant.'),
(3, 11, 'Standard Edition', 'Gracie Abrams delivers an intimate and vulnerable debut. Her songwriting is beyond her years.'),
(4, 29, 'Standard Edition', 'Future Nostalgia is pure disco-pop perfection. Dua Lipa knows how to make you dance.'),
(1, 33, 'Standard Edition', 'Eternal Sunshine shows Ariana Grandes artistic growth. Mature, sophisticated, and beautifully crafted.'),
(2, 40, 'Standard Edition', 'Drake delivers another solid project. The production is top-notch and the features are incredible.'),
(3, 46, 'Standard Edition', 'SZA is at her best in SOS. Raw, emotional, and utterly captivating from start to finish.'),
(4, 51, 'Standard Edition', 'BABYMETAL continues to push boundaries. Metal has never sounded so fresh and exciting.'),
(1, 48, 'Standard Edition', 'NF brings raw honesty and emotion to every track. The Search is a powerful statement.');

